# =============================================================================
# Conecta Teodoro Sampaio - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# Nunca commite o arquivo .env real!

# Supabase - Obtenha em https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
# Alternativa recomendada: chave publicável sb_publishable_... (substitui anon key).
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Somente desenvolvimento local: habilita a demonstração sem banco.
VITE_ENABLE_DEMO=false

# Opcional: Para scripts administrativos (NUNCA exponha no frontend!)
# Use apenas em backend ou scripts locais
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Ambiente
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

# Analytics (opcional)
VITE_ENABLE_ANALYTICS=false

# Contato público e responsável (opcional; não use dados privados)
# VITE_PUBLIC_SUPPORT_EMAIL=suporte@seu-dominio.com.br
# VITE_PUBLIC_ORGANIZATION=Nome da equipe responsável
